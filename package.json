    "web:start": "expo start --web",
    "web:build": "expo export -p web",
    "web:serve": "npx serve dist",
    "web:deploy": "eas deploy",
    "and:aab": "eas build -p android",
    "and:apk": "eas build -p android --profile apk",
    "and:run": "npx expo run:android",
    "ios:start": "expo start --ios",
    "tsc:no:emit": "npx tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "lint": "eslint ."
  },
  "dependencies": {
