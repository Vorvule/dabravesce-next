  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "open:code": "opencode",
    "install:latest": "npm install expo@latest",
    "install:check": "npx expo install --check",
    "install:fix": "expo install --fix",
    "expo:doctor": "npx -y expo-doctor --verbose",
    "expo:start": "expo start --clear",
    "expo:prebuild": "expo prebuild",
